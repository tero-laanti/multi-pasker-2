{
  "name": "multi-pasker",
  "version": "0.1.0",
  "private": true,
  "description": "LAN-selain-FPS: tietokone taisteluun, puhelin varusmestarin viesteihin.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite build && tsx src/server/main.ts",
    "dev": "tsx src/server/main.ts --dev",
    "build": "vite build",
    "serve": "tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:sfx": "tsx tools/gen-sfx.ts",
    "gen:voice": "tsx tools/gen-voice.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
