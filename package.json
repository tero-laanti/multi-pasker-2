{
  "name": "multi-pasker-2",
  "version": "0.1.0",
  "private": true,
  "description": "LAN-selain-FPS: tietokone taisteluun, puhelin varusmestarin viesteihin.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite build && tsx src/server/main.ts",
    "dev": "tsx src/server/main.ts --dev",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "preview:web": "vite preview --mode web --port 8100",
    "deploy:web": "npm run typecheck && npm test && npm run build:web && terraform -chdir=deploy/aws apply",
    "serve": "tsx src/server/main.ts",
    "https:setup": "tsx src/server/https/commands.ts setup",
    "https:policy": "tsx src/server/https/commands.ts policy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:sfx": "tsx tools/gen-sfx.ts",
    "gen:voice": "tsx tools/gen-voice.ts",
    "clean:voice": "tsx tools/clean-voice.ts"
  },
  "dependencies": {
    "@aws-sdk/client-route-53": "3.1151.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@peculiar/x509": "1.14.3",
    "acme-client": "5.4.0",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "uqr": "0.1.3",
    "vite": "8.3.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
